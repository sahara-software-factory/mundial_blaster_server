generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model usuarios {
  id                   String   @id @default(uuid())
  nombre               String
  email                String   @unique
  password             String
  avatar               String   @default("avatar1")
  role                 String   @default("admin")
  security_question    String?
  security_answer      String?
  last_login           DateTime?
  session_token        String?  @unique
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  affiliate_code       String?  @unique

  // Onboarding
  company_name         String?
  phone                String?
  timezone             String   @default("America/Argentina/Buenos_Aires")
  language             String   @default("es")
  industry             String?
  expected_volume      String?
  onboarding_completed Boolean  @default(false)

   // IA Features (nuevas)
  ai_audit_enabled     Boolean  @default(false)
  ai_title_enabled     Boolean  @default(false)
  ai_summary_enabled   Boolean  @default(false)
  ai_translate_enabled Boolean  @default(false)

  // Recuperación
  reset_token          String?
  reset_token_expires  DateTime?
  recovery_code        String?

  // Relaciones
  lineas       lineas_whatsapp[]
  campaigns    campaigns[]
  scheduled    scheduled_campaigns[]
  attachments  campaign_attachments[]
  logs         campaign_logs[]
  contacts     contacts[]
  tags         tags[]
  templates    message_templates[]
  blacklists   blacklist[]
  openai       openai_config[]
  ai_prompts   ai_prompts[]
  proxy_history proxy_history[]
}

model leads {
  id              String   @id @default(uuid())
  nombre          String
  email           String
  company_name    String?
  phone           String?
  industry        String?
  expected_volume String?
  timezone        String?
  user_id         String? 
  created_at      DateTime @default(now())
}

model app_config {
  key   String @id
  value String
}

model lineas_whatsapp {
  id              String   @id @default(uuid())
  phone           String   @unique
  nombre          String   @default("Nueva Línea")
  status          String   @default("DESCONECTADA")
  fecha_creacion  DateTime @default(now())
  
  owner_id        String?
  owner           usuarios? @relation(fields: [owner_id], references: [id], onDelete: SetNull)

  @@index([owner_id])
  @@index([status])
}

model campaigns {
  id                String   @id @default(uuid())  // ← FIX 1: safety net
  name              String?                        // ← FIX 2: nullable para que no explote
  line_id           String?
  message           String
  image_url         String?
  total             Int      @default(0)
  sent              Int      @default(0)
  targets           Json?
  failed            Int      @default(0)
  status            String   @default("running")
  created_at        DateTime @default(now())
  finished_at       DateTime?
  human_mode        Boolean  @default(false)
  distribution_mode String   @default("single")
  proxy_node    String?
  proxy_ip      String?
  selected_lines    String?
  
  owner_id          String?
  owner             usuarios? @relation(fields: [owner_id], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@index([status])
  @@index([owner_id])
  @@index([owner_id, status])
}

model scheduled_campaigns {
  id          String   @id @default(uuid())
  campaign_id String   @unique
  execute_at  DateTime
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  owner_id    String?
  owner       usuarios? @relation(fields: [owner_id], references: [id], onDelete: SetNull)

  @@index([execute_at, status])  // ← FIX 3: polling eficiente
  @@index([owner_id])
}

model campaign_attachments {
  id          String @id @default(uuid())
  campaign_id String
  url         String
  type        String
  filename    String?

  owner_id    String?
  owner       usuarios? @relation(fields: [owner_id], references: [id], onDelete: SetNull)

  @@index([campaign_id])
  @@index([owner_id])
}

model campaign_logs {
  id            String    @id @default(uuid())
  campaign_id   String
  contact_phone String
  status        String
  line_id       String?
  owner_id      String?
  error         String?
  sent_at       DateTime?
  created_at    DateTime  @default(now())
  message_id    String?
  has_reply     Boolean   @default(false)
  replied_at    DateTime?
  delivered_at  DateTime?
  read_at       DateTime?

  owner           usuarios? @relation(fields: [owner_id], references: [id], onDelete: SetNull)

  @@index([campaign_id])
  @@index([contact_phone])
  @@index([created_at])
  @@index([owner_id])
  @@index([line_id])
}

model contacts {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?
  company   String?
  tags      String[] @default([])
  notes     String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner_id  String?
  owner     usuarios? @relation(fields: [owner_id], references: [id], onDelete: SetNull)

  @@index([owner_id])
  @@index([phone])
}

model tags {
  id     String @id @default(uuid())
  name   String
  color  String @default("#3B82F6")
  icon   String?

  owner_id String?
  owner    usuarios? @relation(fields: [owner_id], references: [id], onDelete: SetNull)

  @@unique([owner_id, name])  // ← FIX 4: multi-tenancy real de tags
  @@index([owner_id])
}

model message_templates {
  id         String   @id @default(uuid())
  name       String
  content    String
  category   String   @default("General")
  variables  String[] @default([])
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  imageUrl   String?
  isFavorite Boolean  @default(false)
  owner_id   String?
  owner      usuarios? @relation(fields: [owner_id], references: [id], onDelete: SetNull)

  @@index([owner_id])
  @@index([category])
}

model blacklist {
  id        String   @id @default(uuid())
  phone     String
  reason    String?
  createdAt DateTime @default(now())

  owner_id  String?
  owner     usuarios? @relation(fields: [owner_id], references: [id], onDelete: SetNull)

  @@unique([owner_id, phone])  // ← FIX 5: mismo número puede estar en blacklist de distintos usuarios
  @@index([owner_id])
  @@index([phone])
}

model openai_config {
  id        String   @id @default(uuid())
  owner_id  String
  api_key   String
  model     String   @default("gpt-4o-mini")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     usuarios @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([owner_id])
  @@index([active])
}

model lid_mappings {
  id        String   @id @default(uuid())
  lineId    String
  lid       String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lineId, lid])
  @@index([lineId, phone])
  @@index([lid])
}

model ai_prompts {
  id          String   @id @default(uuid())
  title       String
  instruction String
  results     Json     // array de strings
  owner_id    String?
  owner       usuarios? @relation(fields: [owner_id], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([owner_id])
}

model proxy_history {
  id          String   @id @default(uuid())
  city        String
  country     String
  code        String
  fakeIp      String
  latency     Int
  usedAt      DateTime @default(now())
  timesUsed   Int      @default(1)
  
  owner_id    String?
  owner       usuarios? @relation(fields: [owner_id], references: [id], onDelete: SetNull)

  @@index([owner_id])
  @@index([usedAt])
}